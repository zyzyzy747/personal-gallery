  "parse": {
    "regex": {
      "specBracket": "\\[[^\\[\\]]*\\]",
      "specPair": "(\\d+\\s*[Pp]\\s*\\d*\\s*[Vv]?)\\s*[-–]?\\s*(\\d+(?:\\.\\d+)?\\s*[MmGg][Bb]?)",
      "countOnly": "(?<![\\w.])\\d{1,4}\\s*[Pp](?:\\s*\\d{1,2}\\s*[Vv])?(?!\\w)",
      "sizeOnly": "(?<![\\w.])\\d+(?:\\.\\d+)?\\s*[MmGg][Bb]?(?!\\w)",
      "time": "(\\d{2,4}\\s*年\\s*\\d{1,2}\\s*月(\\s*计划\\s*[A-Za-z0-9])?|\\d{4}\\s*[.\\-/]\\s*\\d{1,2}(\\s*[.\\-/]\\s*\\d{1,2})?|\\d{1,2}\\.\\d{1,2}\\s*月号|\\d{1,2}\\s*月号|\\d{4}\\s*年(\\s*\\S{1,4}年?)?|计划\\s*[A-Za-z0-9]|Tier|Part\\s*\\d+|第\\s*\\d+\\s*[期回]|(\\d{1,2}\\s*[-–]\\s*\\d{1,2})|(\\d{4}[A-Za-z]{3}(\\d{2})?))",
      "hashTag": "#([^\\s#\\[\\]]+)",
      "emoji": "[\\U0001F000-\\U0001FAFF\\U0001F1E6-\\U0001F1FF\\U0001F900-\\U0001F9FF\\u2190-\\u21FF\\u2300-\\u27BF\\u2B00-\\u2BFF\\uFE0F\\u20E3\\u2764\\u2B50]+",
      "dashChars": "‐‑‒–—―−－ー~～",
      "datePrefix": "^\\s*\\d{2}\\s*年\\s*\\d{1,2}\\s*月"
    },
    "order": [
      "S0-normalize",
      "S1-strip-spec",
      "S2-depth-split",
      "S3-extract-groups",
      "S4-resolve-coser",
      "S5-chunk-tags",
      "S6-split-bare",
      "S7-classify",
      "S8-parse-time"
    ],
    "_orderNote": "S1 必须先提取再剥离方括号，否则 pages/size 提取率为 0。S2 必须先深度切分再抽括号，否则括号内 ' - ' 变假分隔符。未闭合括号内容不得回填主串。",
